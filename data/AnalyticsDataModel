------------------------------------------------------------
-- TEAM STATIC INFO
------------------------------------------------------------
CREATE TABLE Teams_Static (
    team_static_id INTEGER PRIMARY KEY AUTOINCREMENT,
    club TEXT NOT NULL,
    team TEXT NOT NULL,
    age TEXT,
    home_ice TEXT
);

------------------------------------------------------------
-- TEAM SEASON INFO
------------------------------------------------------------
CREATE TABLE Teams (
    team_id INTEGER PRIMARY KEY AUTOINCREMENT,
    team_static_id INTEGER,
    season YEAR,
    coach TEXT,
    league TEXT,
    division TEXT,
    FOREIGN KEY (team_static_id) REFERENCES Teams_Static(team_static_id)
);

------------------------------------------------------------
-- PLAYER STATIC INFO
------------------------------------------------------------
CREATE TABLE Players_Static (
    player_static_id INTEGER PRIMARY KEY AUTOINCREMENT,
    player_last_name TEXT NOT NULL,
    player_first_name TEXT NOT NULL,
    player_go_by TEXT,
    player_parents TEXT,
    birth_year YEAR,
    height_in NUMBER,
    weight_lbs NUMBER,
    shoots TEXT CHECK (shoots IN ('L','R','-')),
    catches TEXT CHECK (catches IN ('L','R','-'))
);

------------------------------------------------------------
-- PLAYER SEASON INFO
------------------------------------------------------------
CREATE TABLE Players (
    player_id INTEGER PRIMARY KEY AUTOINCREMENT,
    player_static_id INTEGER,
    team_id INTEGER,
    season YEAR,
    jersey_num INTEGER,
    position INTEGER,
    line INTEGER,
    FOREIGN KEY (player_static_id) REFERENCES Players_Static(player_static_id),
    FOREIGN KEY (team_id) REFERENCES Teams(team_id),
    FOREIGN KEY (position) REFERENCES dict_position(pos_id)
);

------------------------------------------------------------
-- GAMES
------------------------------------------------------------
CREATE TABLE Games (
    game_id INTEGER PRIMARY KEY AUTOINCREMENT,
    rink_id INTEGER,
    season YEAR,
    game_date DATE,
    puck_drop TIME DEFAULT "12:00:00.00",
    home_team_id INTEGER,
    away_team_id INTEGER,
    game_type INTEGER DEFAULT 1,
    rules INTEGER DEFAULT 1,
    home_score INTEGER,
    away_score INTEGER,
    home_sog INTEGER,
    away_sog INTEGER,
    overtime BOOLEAN DEFAULT FALSE,
    shootout BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (home_team_id) REFERENCES Teams(team_id),
    FOREIGN KEY (away_team_id) REFERENCES Teams(team_id),
    FOREIGN KEY (game_type) REFERENCES dict_gametype(type_id),
    FOREIGN KEY (rules) REFERENCES dict_rules(r_id)
);

------------------------------------------------------------
-- SHIFTS
------------------------------------------------------------
CREATE TABLE Shifts (
    shift_id INTEGER PRIMARY KEY AUTOINCREMENT,
    game INTEGER NOT NULL,
    period INTEGER,
    start_clock_time_sec INTEGER,
    end_clock_time_sec INTEGER,
    empty_net_away BOOLEAN DEFAULT FALSE,
    empty_net_home BOOLEAN DEFAULT FALSE,
    home_skaters INTEGER,
    away_skaters INTEGER,
    FOREIGN KEY (game) REFERENCES Games(game_id),
    FOREIGN KEY (period) REFERENCES dict_period(p_id)
);

------------------------------------------------------------
-- SKATERS ON ICE
------------------------------------------------------------
CREATE TABLE Skaters (
    line_id INTEGER PRIMARY KEY AUTOINCREMENT,
    shift_id INTEGER NOT NULL,
    player_id INTEGER,
    position INTEGER,
    FOREIGN KEY (shift_id) REFERENCES Shifts(shift_id),
    FOREIGN KEY (player_id) REFERENCES Players(player_id),
    FOREIGN KEY (position) REFERENCES dict_position(pos_id)
);

------------------------------------------------------------
-- SHOTS
------------------------------------------------------------
CREATE TABLE Shots (
    shot_id INTEGER PRIMARY KEY AUTOINCREMENT,
    shift_id INTEGER NOT NULL,
    period_id INTEGER,
    clock_time_sec INTEGER,
    team_id INTEGER,
    shooter_id INTEGER NOT NULL,
    shot_result INTEGER,
    x_location_ft REAL,
    y_location_ft REAL,
    is_rebound BOOLEAN,
    is_rush BOOLEAN,
    is_one_timer BOOLEAN,
    is_screened BOOLEAN,
    is_deflection BOOLEAN,
    first_assist_id INTEGER,
    second_assist_id INTEGER,
    FOREIGN KEY (shift_id) REFERENCES Shifts(shift_id),
    FOREIGN KEY (period_id) REFERENCES dict_period(p_id),
    FOREIGN KEY (team_id) REFERENCES Teams(team_id),
    FOREIGN KEY (shooter_id) REFERENCES Players(player_id),
    FOREIGN KEY (first_assist_id) REFERENCES Players(player_id),
    FOREIGN KEY (second_assist_id) REFERENCES Players(player_id),
    FOREIGN KEY (shot_result) REFERENCES dict_shotresult(s_id)
);

------------------------------------------------------------
-- PENALTIES
------------------------------------------------------------
CREATE TABLE Penalties (
    penalty_id INTEGER PRIMARY KEY AUTOINCREMENT,
    shift_id INTEGER NOT NULL,
    period_id INTEGER,
    clock_time_sec INTEGER,
    team_id INTEGER,
    player_id INTEGER NOT NULL,
    drawn_by_id INTEGER,
    served_by_id INTEGER,
    penalty INTEGER,
    penalty_type INTEGER,
    minutes INTEGER,
    is_coincidental BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (shift_id) REFERENCES Shifts(shift_id),
    FOREIGN KEY (period_id) REFERENCES dict_period(p_id),
    FOREIGN KEY (team_id) REFERENCES Teams(team_id),
    FOREIGN KEY (player_id) REFERENCES Players(player_id),
    FOREIGN KEY (drawn_by_id) REFERENCES Players(player_id),
    FOREIGN KEY (served_by_id) REFERENCES Players(player_id),
    FOREIGN KEY (penalty) REFERENCES dict_penalty(p_id),
    FOREIGN KEY (penalty_type) REFERENCES dict_penalty_type(p_id)
);

------------------------------------------------------------
-- FACEOFFS
------------------------------------------------------------
CREATE TABLE Faceoffs (
    drop_id INTEGER PRIMARY KEY AUTOINCREMENT,
    shift_id INTEGER NOT NULL,
    face_off_reason INTEGER NOT NULL,
    clock_time_sec INTEGER,
    home_player_id INTEGER,
    away_player_id INTEGER,
    winning_player_id INTEGER,
    winning_team_id INTEGER,
    losing_team_id INTEGER,
    home_zone TEXT CHECK (home_zone IN ('OZ','NZ','DZ')),
    FOREIGN KEY (shift_id) REFERENCES Shifts(shift_id),
    FOREIGN KEY (face_off_reason) REFERENCES dict_faceoff(fo_id),
    FOREIGN KEY (home_player_id) REFERENCES Players(player_id),
    FOREIGN KEY (away_player_id) REFERENCES Players(player_id),
    FOREIGN KEY (winning_player_id) REFERENCES Players(player_id),
    FOREIGN KEY (winning_team_id) REFERENCES Teams(team_id),
    FOREIGN KEY (losing_team_id) REFERENCES Teams(team_id)
);
